{
  "name": "inwebo/open-resume-model",
  "description": "Open resume PHP model implementation.",
  "keywords": [
    "symfony",
    "bundle",
    "open-resume"
  ],
  "homepage": "https://github.com/inwebo/open-resume-model",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": "^8.0|^7.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89",
    "phpstan/phpstan": "^2.1"
  },
  "license": "GPL-3.0-or-later",
  "autoload": {
    "psr-4": {
      "Inwebo\\OpenResumeModel\\": "src/"
    }
  },
  "authors": [
    {
      "name": "inwebo",
      "email": "github@inwebo.net"
    }
  ],
  "minimum-stability": "stable",
  "scripts": {
    "php-cs-fixer": "vendor/bin/php-cs-fixer --allow-risky=yes fix",
    "phpstan": "vendor/bin/phpstan analyse src -c phpstan.neon"
  }
}
